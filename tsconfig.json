{
  "compilerOptions": {
    "baseUrl": "./",
    "paths": {
      "#config": ["src/config"],
      "#classes": ["src/classes/index"],
      "#contracts": ["src/contracts/index"],
      "#utils": ["src/utils"],
      "#errors": ["src/errors"],
      "#types": ["src/types"]
    },
    "rootDir": "./src",
    "outDir": "./dist",
    "module": "nodenext",
    "target": "esnext",
    "types": ["node"],
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitReturns": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noPropertyAccessFromIndexSignature": false,
    "strict": true,
    "strictNullChecks": false,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "skipLibCheck": true
  }
}
